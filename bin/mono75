#!/usr/bin/env bash
# Launcher aplikasi vendor MONO 75 lewat Wine.
# Repo ini tidak lagi berisi CLI. Satu-satunya perintah adalah mono75
# tanpa argumen, untuk membuka GUI vendor.
set -e

if [ $# -gt 0 ]; then
    case "$1" in
        -h|--help)
            echo "Penggunaan: mono75"
            echo "Membuka aplikasi vendor MONO 75 (DeviceDriver.exe) lewat Wine."
            echo "Tidak ada subcommand. Versi CLI Python sudah dihapus dari repo ini."
            exit 0
            ;;
        *)
            echo "mono75 tidak punya subcommand lagi." >&2
            echo "Jalankan tanpa argumen untuk membuka GUI, atau mono75 -h untuk bantuan." >&2
            exit 1
            ;;
    esac
fi

export WINEPREFIX="${WINEPREFIX:-${XDG_DATA_HOME:-$HOME/.local/share}/mono75/wineprefix}"
export WINEDEBUG="-all"
export WINEDLLOVERRIDES="mscoree,mshtml="

APP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/mono75/app"
# Instalasi lama bisa menyimpan exe di app/mono75app/. Pakai folder itu
# sebagai APP_DIR supaya launcher baru tetap jalan tanpa instal ulang.
if [ -f "$APP_DIR/mono75app/DeviceDriver.exe" ] && [ ! -f "$APP_DIR/DeviceDriver.exe" ]; then
    APP_DIR="$APP_DIR/mono75app"
fi
WINE_APP="${WINEPREFIX}/drive_c/mono75app"

if ! command -v wine >/dev/null 2>&1; then
    echo "Error: wine tidak ditemukan di PATH." >&2
    echo "GUI vendor membutuhkan Wine. Pasang Wine dulu, misalnya:" >&2
    echo "  Arch / CachyOS: sudo pacman -S wine" >&2
    echo "  Ubuntu / Debian: sudo apt install wine" >&2
    echo "  Fedora: sudo dnf install wine" >&2
    exit 1
fi

if [ ! -d "$WINE_APP" ]; then
    if [ -d "$APP_DIR" ]; then
        mkdir -p "${WINEPREFIX}/drive_c"
        ln -sfn "$APP_DIR" "$WINE_APP"
    else
        echo "Error: direktori aplikasi tidak ditemukan di $APP_DIR" >&2
        echo "Jalankan install.sh lagi, atau pasang ulang paket aplikasi vendor." >&2
        exit 1
    fi
fi

cd "$WINE_APP"
exec wine "C:\\mono75app\\DeviceDriver.exe"
